# ==========================================
# RASHAD AI - المنظومة الوطنية لدعم القرار الزكوي
# Environment Configuration Template (.env.example)
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="RASHAD AI"
API_V1_STR="/api/v1"

# Security & Tokens
# NOTE: Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL 18 Local)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rashad_ai_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rashad_ai_dev

# Storage for Beneficiary Documents (Local encrypted sandbox)
UPLOAD_DIR=./storage/documents
MAX_UPLOAD_SIZE_MB=10

# AI & Synthetic Data Settings
SYNTHETIC_DATA_SEED=42
OCR_ENABLED=True
DEFAULT_GOV_CODE=YE-SN
